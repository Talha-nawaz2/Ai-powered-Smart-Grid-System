ENV=development
DEBUG=true

# ---- AI Grid Copilot ----
# Recommended: Gemini (Google) - free tier, no credit card required, includes
# function calling. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative: OpenAI (requires paid credits, no free tier)
OPENAI_API_KEY=sk-your-key-here
COPILOT_MODEL=gpt-4o-mini

# If NEITHER key above is set, the Copilot automatically uses a rule-based
# keyword fallback instead - the platform stays fully demoable either way.
